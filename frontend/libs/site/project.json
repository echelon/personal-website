{
  "name": "site",
  "sourceRoot": "libs/site/src",
  "projectType": "application",
  "implicitDependencies": ["embeds"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "cargo run --manifest-path ../Cargo.toml --locked --release -- build --config ../config.toml" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --project tsconfig.json && tsc --project tsconfig.tools.json" }
    }
  }
}
