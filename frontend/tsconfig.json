{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@brand/embeds": ["libs/embeds/src/index.ts"] }
  },
  "include": ["libs/**/*.ts", "libs/**/*.tsx", "../articles/**/*.ts", "../articles/**/*.tsx"],
  "exclude": ["../articles/**/.tests/**"]
}
